# ==============================================================================
# CONFIGURACIÓN DEL PROYECTO: TWINBER EN BUSCA DEL SECRETO GUANCHE
# ==============================================================================

# Credenciales de OpenAI (requerido para el motor agéntico y embeddings)
OPENAI_API_KEY="sk-proj-tu-clave-activa-aqui"

# Modelos seleccionados (configurables libremente)
OPENAI_MODEL_MAIN="gpt-4o-mini"
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Configuración del entorno de juego y persistencia
CHROMA_PERSIST_DIRECTORY="./chroma_db"
GAME_AUDIT_LOG_PATH="./game_audit.log"
ASSETS_DIR="./assets"

# Opciones de despliegue automatizado en Kubernetes k3s (opcional para make deploy)
# K8S_SSH_TARGET="user@your-vps-server"
# K8S_DOMAIN="tenerife.yourdomain.com"

